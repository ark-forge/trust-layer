# Stripe
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TL_WEBHOOK_SECRET=whsec_...
STRIPE_TL_WEBHOOK_SECRET_TEST=whsec_...

# SMTP (proof + welcome emails)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
IMAP_USER=contact@arkforge.fr
IMAP_PASSWORD=

# Trust Layer
TRUST_LAYER_BASE_URL=https://trust.arkforge.tech

# Limits (defaults shown)
# AMOUNT_MIN=0.50
# AMOUNT_MAX=50.00
# RATE_LIMIT_PER_KEY_PER_DAY=200
# PROXY_TIMEOUT_SECONDS=120

# --- Service-to-service secrets forwarded by /v1/proxy ---
# Each secret is forwarded ONLY to the hostnames listed for it (comma-separated).
# Empty allowlist = never forwarded. Never share one secret between two uses:
# rotation then becomes an event for both, and the blast radius of a leak is the
# union of their surfaces (v1.7.0).
TRUST_LAYER_INTERNAL_SECRET=
TRUST_LAYER_TRUSTED_INTERNAL_HOSTS=

# PROVE IT challenge corpus. Deliberately distinct from the secret above: the
# corpus is exposed to challenge participants.
TRUST_LAYER_CHALLENGE_SECRET=
# e.g. TRUST_LAYER_CHALLENGE_HOSTS=corpus.arkforge.tech
TRUST_LAYER_CHALLENGE_HOSTS=
# Before the season opens, only these key fingerprints (sha256 of the API key,
# comma-separated) receive the challenge secret. Only "true" opens the season.
TRUST_LAYER_CHALLENGE_KEYS=
TRUST_LAYER_CHALLENGE_OPEN=false
